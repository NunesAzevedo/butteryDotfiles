{
    "include": ["~/.config/waybar/clock.jsonc"],
    
    "layer": "top",
    "position": "top",
    "margin-top": 2,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 5,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "power-profiles-daemon", 
        "battery",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true
    },

    "tray": {
        "spacing": 8
    },

    "network": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "⚠  Offline",
        "tooltip-format": "{essid} - {ipaddr}/{cidr}",
        "on-click": "~/.config/hypr/scripts/wofi_wifi/wofi_wifi.sh",
        "on-click-right": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "  {}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 2
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}°C",
        "format-icons": ["", "", ""],
        "interval": 2
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Perfil: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "nwg-bar"
    }
}
